# Kopieren Sie diese Datei nach `backend/.env` und tragen Sie die Werte ein.
# `JWT_SECRET` wird zum Signieren der JWTs benötigt. Erzeugen Sie einen Wert mit:
#   py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# SQLAlchemy-Datenbank-URL (SQLite-Standard).
DATABASE_URL=sqlite:///./wardrobe.db

# Verzeichnis für hochgeladene Bilder.
UPLOAD_DIR=./uploads

# Vom CORS erlaubte Origin des Frontends.
FRONTEND_ORIGIN=http://localhost:5173
